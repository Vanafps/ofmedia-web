{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app/apk",
      "destination": "/index.html"
    },
    {
      "source": "/apk",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|.*\\.(?:json|apk|png|jpg|jpeg|svg|ico|ttf|woff|woff2|js|css|webmanifest)).*)",
      "destination": "/index.html"
    }
  ]
}